{
  "//": "Type-checks the examples/ against the source (via path mapping) so copy-first code stays valid. Run: npm run typecheck:examples. NOTE: JSX types are permissive (see src/jsx-runtime.ts) — this catches import/API errors, not per-attribute web typing yet.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "jsx": "preserve",
    "jsxImportSource": "@doeixd/affe",
    // TS7 removed baseUrl; keep path mappings relative to this config file.
    "paths": {
      "@doeixd/affe": ["./src/index.ts"],
      "@doeixd/affe/jsx-runtime": ["./src/jsx-runtime.ts"],
      "@doeixd/affe/jsx-dev-runtime": ["./src/jsx-runtime.ts"],
      "@doeixd/affe/testing": ["./src/testing.ts"],
      "@doeixd/affe/runtime": ["./src/runtime.ts"],
      "@doeixd/affe/advanced": ["./src/advanced.ts"],
      "@doeixd/affe/internals": ["./src/internals.ts"],
      "@doeixd/affe/server": ["./src/server.ts"],
      "@doeixd/affe/router-runtime": ["./src/router-runtime.ts"],
      "@doeixd/affe-permissive": ["./packages/permissive/src/index.ts"],
      "@doeixd/affe-permissive/client": ["./packages/permissive/src/client.ts"],
      "@doeixd/affe/*": ["./src/*"]
    }
  },
  "include": ["examples/**/*.ts", "examples/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
