{
  "name": "@doeixd/affe-agent",
  "version": "0.0.0",
  "description": "Agent-surface adapters for affe: the MCP projection over the Agent catalog (tools from schemas, dispatch through the one governance pipeline). An adapter package per DQ-096 — never a fork of the core surface.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@doeixd/affe": "file:../.."
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta"
  }
}
